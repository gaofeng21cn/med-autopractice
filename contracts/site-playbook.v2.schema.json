{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://med-auto-practice.local/contracts/site-playbook.v2",
  "title": "MAP transport-agnostic declarative site playbook v2",
  "description": "An ordered, channel-agnostic site procedure kept outside the source repository; supports computer_use, ip_kvm and hybrid declarative UI execution without credentials or patient data.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "playbook_id", "site_id", "title", "systems", "steps"],
  "properties": {
    "schema_version": {"const": "map-site-playbook.v2"},
    "playbook_id": {"type": "string", "minLength": 1},
    "site_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string"},
    "systems": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "account_ref": {"type": ["string", "null"]},
    "evidence_dir_ref": {"type": ["string", "null"]},
    "revision_ref": {"type": ["string", "null"]},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "intent", "primitive", "expect_text", "effect", "on_failure"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "intent": {"type": "string", "minLength": 1},
          "primitive": {
            "enum": [
              "observe", "locate", "click", "double_click", "keys",
              "input_text", "select_option", "wait_state",
              "read_text", "read_table", "scroll_collect",
              "verify_subject", "handle_dialog", "capture_evidence", "human_handoff",
              "kvm_observe", "kvm_wait", "kvm_click", "kvm_double_click",
              "kvm_type_ascii", "kvm_keys", "kvm_scroll", "kvm_drag",
              "browser_autofill_select", "human_action"
            ]
          },
          "target": {"type": ["string", "null"]},
          "selector": {"type": ["string", "null"]},
          "text_param": {"type": ["string", "null"]},
          "extract_key": {"type": ["string", "null"]},
          "scope": {"type": ["string", "null"]},
          "max_pages": {"type": ["integer", "null"], "minimum": 1, "maximum": 100},
          "dialog_rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["trigger_text", "action"],
              "properties": {
                "trigger_text": {"type": "string", "minLength": 1},
                "action": {"enum": ["dismiss", "confirm", "handoff"]},
                "target": {"type": ["string", "null"]}
              }
            }
          },
          "region_hint": {
            "anyOf": [
              {
                "type": "array",
                "minItems": 4,
                "maxItems": 4,
                "items": {"type": "integer", "minimum": 0, "maximum": 8192}
              },
              {"type": "null"}
            ]
          },
          "expect_text": {"type": "string", "minLength": 1},
          "effect": {"enum": ["read_only", "draft_write", "reviewed_write"]},
          "on_failure": {"enum": ["stop", "retry_once", "handoff", "reobserve"]},
          "state": {"enum": ["unverified", "verified", "revoked"]},
          "evidence": {"enum": ["none", "ref", "screenshot_ref"]},
          "notes_ref": {"type": ["string", "null"]}
        }
      }
    }
  }
}
