{
  "strategy": "daily_patch",
  "prepare": [
    [
      "python3",
      "scripts/package_metadata.py",
      "--write-lock"
    ]
  ],
  "verify": [
    [
      "python3",
      "scripts/package_metadata.py"
    ]
  ],
  "version_files": [
    {
      "path": "pyproject.toml",
      "kind": "toml_project"
    },
    {
      "path": "agent/manifest.json",
      "kind": "json"
    }
  ]
}
