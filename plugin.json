{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/plugin.schema.json",
  "name": "med-autopractice",
  "version": "0.1.1",
  "description": "Clinician-directed agent for medical records, order review and hospital system integration.",
  "author": {
    "name": "Gao Feng",
    "url": "https://github.com/gaofeng21cn"
  },
  "repository": "https://github.com/gaofeng21cn/med-autopractice",
  "keywords": [
    "clinical-workflow",
    "codex",
    "medical-records",
    "domain-agent"
  ],
  "extensions": {
    "com.openai": {
      "interface": {
        "displayName": "Med Auto Practice",
        "shortDescription": "整理病历、准备医嘱并复核系统结果",
        "longDescription": "在 Codex 中整理结构化病历、审阅医嘱草案、核对来源和执行结果。部署团队可以用合成示例适配医院系统。",
        "developerName": "Gao Feng",
        "category": "Productivity",
        "capabilities": [
          "Interactive"
        ],
        "websiteURL": "https://github.com/gaofeng21cn/med-autopractice",
        "composerIcon": "./assets/branding/medautopractice-logo.png",
        "logo": "./assets/branding/medautopractice-logo.png",
        "defaultPrompt": [
          "查看 MAP 能力状态并运行合成医嘱演示。"
        ]
      }
    }
  }
}
